<idea-plugin require-restart="true">
  <id>dev.kona.idea</id>
  <name>Kona</name>
  <vendor url="https://github.com/konaframework/kona-idea">Kona Framework</vendor>
  <description><![CDATA[
    <p><b>Kona Idea</b> — native JetBrains support for the Kona framework
    (IntelliJ IDEA Community and Ultimate). <b>No LSP</b> — completion,
    navigation, and inspections use IntelliJ platform APIs.</p>
    <ul>
      <li>Crema (<code>*.crema.html</code>, <code>*.crema.kt</code>) — HTML colors
          with Crema directive / echo overlays, <code>@</code> completion, and annotator</li>
      <li>View name autocomplete + Go to Declaration (<b>Ctrl+B</b> / Ctrl+Click)</li>
      <li>DB column completion from Extract migrations and optional JDBC (<code>DB_URL</code>)</li>
      <li>Right-side <b>Kona</b> tool window — grind serve, common commands, docs</li>
      <li>Project layout markers and official Kona brand icons</li>
      <li><b>Grind</b> run configurations — <code>./grind serve</code> (Netty, port
          <code>4000</code>)</li>
      <li>File templates and live templates for typed Router handlers, Extract,
          Auth, filesystem disks, Queue <code>Bus</code>, Schedule, and Crema</li>
    </ul>
    <p>Sideload a zip from
    <a href="https://github.com/konaframework/kona-idea/releases">GitHub Releases</a>,
    or install from the JetBrains Marketplace when published.</p>
    <p><b>Note:</b> installing, updating, or removing this plugin requires an IDE restart.</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xml</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Crema"
        implementationClass="dev.kona.idea.CremaFileType"
        fieldName="INSTANCE"
        language="Crema"
        extensions="crema.html;crema.kt"
        patterns="*.crema.html;*.crema.kt"/>

    <fileTypeOverrider implementation="dev.kona.idea.CremaFileTypeOverrider"/>
    <fileTypeDetector implementation="dev.kona.idea.CremaFileTypeDetector" order="first"/>

    <lang.parserDefinition language="Crema" implementationClass="dev.kona.idea.CremaParserDefinition"/>
    <lang.fileViewProviderFactory language="Crema" implementationClass="dev.kona.idea.CremaFileViewProviderFactory"/>

    <lang.syntaxHighlighterFactory language="Crema" implementationClass="dev.kona.idea.CremaSyntaxHighlighterFactory"/>
    <editorHighlighterProvider filetype="Crema" implementationClass="dev.kona.idea.CremaEditorHighlighterProvider"/>

    <typedHandler implementation="dev.kona.idea.CremaTypedHandler"/>
    <lang.braceMatcher language="Crema" implementationClass="dev.kona.idea.CremaBraceMatcher"/>

    <configurationType implementation="dev.kona.idea.GrindConfigurationType"/>
    <postStartupActivity implementation="dev.kona.idea.KonaProjectOpenActivity"/>
    <iconProvider implementation="dev.kona.idea.KonaFolderIconProvider"/>
    <fileTemplateGroup implementation="dev.kona.idea.KonaFileTemplates"/>
    <defaultLiveTemplates file="/liveTemplates/Kona.xml"/>

    <completion.contributor language="any" implementationClass="dev.kona.idea.CremaCompletionContributor" order="first"/>
    <completion.contributor language="any" implementationClass="dev.kona.idea.ViewNameCompletionContributor"/>
    <completion.contributor language="any" implementationClass="dev.kona.idea.DbColumnCompletionContributor"/>
    <annotator language="Crema" implementationClass="dev.kona.idea.CremaAnnotator"/>

    <psi.referenceContributor language="any" implementation="dev.kona.idea.ViewNameReferenceContributor"/>
    <gotoDeclarationHandler implementation="dev.kona.idea.ViewGotoDeclarationHandler"/>

    <toolWindow
        id="Kona"
        anchor="right"
        icon="/icons/konaToolWindow.svg"
        factoryClass="dev.kona.idea.KonaToolWindowFactory"
        secondary="false"/>
  </extensions>

  <actions>
    <group id="Kona.Menu"
           text="Kona"
           description="Kona Idea"
           icon="/icons/kona.svg"
           popup="true">
      <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Kona.ShowLayoutHelp"
              class="dev.kona.idea.ShowLayoutHelpAction"
              text="Show Project Layout Help"
              description="Canonical kona new / grind scaffold folders and Netty serve"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowRoutingHelp"
              class="dev.kona.idea.ShowRoutingHelpAction"
              text="Show Routing Help"
              description="Typed Router handlers (prefer instance/lambda)"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowArtifactsHelp"
              class="dev.kona.idea.ShowArtifactsHelpAction"
              text="Show Maven Modules Help"
              description="dev.kona artifact coordinates"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowViewNavHelp"
              class="dev.kona.idea.ShowViewNavHelpAction"
              text="Show View Navigation Help"
              description="Ctrl+B / Ctrl+Click to open Crema views"
              icon="/icons/kona.svg"/>
    </group>

    <action id="Kona.NewCremaView"
            class="dev.kona.idea.NewCremaViewAction"
            text="Crema View"
            description="Create a Kona Crema view (*.crema.html)"
            icon="/icons/kona.svg">
      <add-to-group group-id="NewGroup" anchor="first"/>
    </action>
  </actions>
</idea-plugin>
