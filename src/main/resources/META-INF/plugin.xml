<idea-plugin require-restart="true">
  <id>org.konaframework.idea</id>
  <name>Kona</name>
  <vendor url="https://github.com/konaframework/kona-idea">Kona Framework</vendor>
  <description><![CDATA[
    <p><b>Kona Idea</b> — native JetBrains support for the Kona framework
    (IntelliJ IDEA Community and Ultimate). <b>No LSP</b> — completion,
    navigation, and inspections use IntelliJ platform APIs.</p>
    <ul>
      <li>Crema (<code>*.crema.html</code>, <code>*.crema.kt</code>) — HTML colors
          with Crema directive / echo overlays, <code>@</code> autopopup completion,
          <code>&lt;x-*&gt;</code> component tags, and annotator</li>
      <li>Brew <code>wire:*</code> attribute completion + weak warnings
          (<code>org.konaframework:kona-brew</code>)</li>
      <li>View / Inertia page-name autocomplete + Go to Declaration
          (<b>Ctrl+B</b> / Ctrl+Click) for Crema, Brew, and
          <code>Inertia.render</code></li>
      <li>Cadence model attribute / DB column completion (migrations and/or JDBC),
          scoped to the model’s table; configure source under
          <b>Settings → Tools → Kona</b></li>
      <li>Right-side <b>Kona</b> tool window — grind serve, Brew+Inertia help, docs</li>
      <li>Project layout markers and official Kona brand icons</li>
      <li><b>Grind</b> run configurations — <code>./grind serve</code> (Netty, port
          <code>4000</code>)</li>
      <li>File templates and live templates for typed Router handlers, Cadence,
          Auth, filesystem disks, Queue <code>Bus</code>, Schedule, Crema, and Inertia</li>
    </ul>
    <p>Sideload a zip from
    <a href="https://github.com/konaframework/kona-idea/releases">GitHub Releases</a>,
    or install from the JetBrains Marketplace when published.</p>
    <p><b>Note:</b> installing, updating, or removing this plugin requires an IDE restart.</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xml</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Crema"
        implementationClass="org.konaframework.idea.CremaFileType"
        fieldName="INSTANCE"
        language="Crema"
        extensions="crema.html;crema.kt"
        patterns="*.crema.html;*.crema.kt"/>

    <fileTypeOverrider implementation="org.konaframework.idea.CremaFileTypeOverrider"/>
    <fileTypeDetector implementation="org.konaframework.idea.CremaFileTypeDetector" order="first"/>

    <lang.parserDefinition language="Crema" implementationClass="org.konaframework.idea.CremaParserDefinition"/>
    <lang.fileViewProviderFactory language="Crema" implementationClass="org.konaframework.idea.CremaFileViewProviderFactory"/>

    <lang.syntaxHighlighterFactory language="Crema" implementationClass="org.konaframework.idea.CremaSyntaxHighlighterFactory"/>
    <editorHighlighterProvider filetype="Crema" implementationClass="org.konaframework.idea.CremaEditorHighlighterProvider"/>

    <typedHandler implementation="org.konaframework.idea.CremaTypedHandler"/>
    <lookup.charFilter implementation="org.konaframework.idea.CremaCharFilter"/>
    <lang.braceMatcher language="Crema" implementationClass="org.konaframework.idea.CremaBraceMatcher"/>

    <configurationType implementation="org.konaframework.idea.GrindConfigurationType"/>
    <postStartupActivity implementation="org.konaframework.idea.KonaProjectOpenActivity"/>
    <iconProvider implementation="org.konaframework.idea.KonaFolderIconProvider"/>
    <fileTemplateGroup implementation="org.konaframework.idea.KonaFileTemplates"/>
    <defaultLiveTemplates file="/liveTemplates/Kona.xml"/>

    <projectConfigurable
        parentId="tools"
        instance="org.konaframework.idea.KonaConfigurable"
        id="org.konaframework.idea.settings"
        displayName="Kona"/>

    <completion.contributor language="any" implementationClass="org.konaframework.idea.CremaCompletionContributor" order="first"/>
    <completion.contributor language="any" implementationClass="org.konaframework.idea.XComponentCompletionContributor" order="first"/>
    <completion.contributor language="any" implementationClass="org.konaframework.idea.BrewWireCompletionContributor" order="first"/>
    <completion.contributor language="any" implementationClass="org.konaframework.idea.ViewNameCompletionContributor"/>
    <completion.contributor language="any" implementationClass="org.konaframework.idea.DbColumnCompletionContributor"/>
    <completion.contributor language="any" implementationClass="org.konaframework.idea.ModelPropertyCompletionContributor"/>
    <annotator language="Crema" implementationClass="org.konaframework.idea.CremaAnnotator"/>
    <annotator language="Crema" implementationClass="org.konaframework.idea.BrewWireAnnotator"/>

    <psi.referenceContributor language="any" implementation="org.konaframework.idea.ViewNameReferenceContributor"/>
    <gotoDeclarationHandler implementation="org.konaframework.idea.ViewGotoDeclarationHandler"/>

    <toolWindow
        id="Kona"
        anchor="right"
        icon="/icons/konaToolWindow.svg"
        factoryClass="org.konaframework.idea.KonaToolWindowFactory"
        secondary="false"/>
  </extensions>

  <actions>
    <group id="Kona.Menu"
           text="Kona"
           description="Kona Idea"
           icon="/icons/kona.svg"
           popup="true">
      <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Kona.ShowLayoutHelp"
              class="org.konaframework.idea.ShowLayoutHelpAction"
              text="Show Project Layout Help"
              description="Canonical kona new / grind scaffold folders and Netty serve"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowRoutingHelp"
              class="org.konaframework.idea.ShowRoutingHelpAction"
              text="Show Routing Help"
              description="Typed Router handlers (prefer instance/lambda)"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowArtifactsHelp"
              class="org.konaframework.idea.ShowArtifactsHelpAction"
              text="Show Maven Modules Help"
              description="org.konaframework artifact coordinates"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowViewNavHelp"
              class="org.konaframework.idea.ShowViewNavHelpAction"
              text="Show View Navigation Help"
              description="Ctrl+B / Ctrl+Click to open Crema views"
              icon="/icons/kona.svg"/>
      <action id="Kona.ShowBrewInertiaHelp"
              class="org.konaframework.idea.ShowBrewInertiaHelpAction"
              text="Show Brew + Inertia Help"
              description="kona-brew wire:* and kona-inertia page templates"
              icon="/icons/kona.svg"/>
    </group>

    <action id="Kona.NewCremaView"
            class="org.konaframework.idea.NewCremaViewAction"
            text="Crema View"
            description="Create a Kona Crema view (*.crema.html)"
            icon="/icons/kona.svg">
      <add-to-group group-id="NewGroup" anchor="first"/>
    </action>
  </actions>
</idea-plugin>
